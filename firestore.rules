// Firestore rules for Workbook.
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Each signed-in person can read and write only their own data under
// users/{their uid}/…  Nobody else (signed in or not) can see it.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
